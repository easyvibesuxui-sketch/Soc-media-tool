# Public, build-time values. Safe to commit: the URL and publishable key ship
# to every browser anyway, and RLS is what protects the data.
# NEXT_PUBLIC_* are inlined at BUILD time, so they must exist where the build
# runs (Cloudflare's Git build included) — committing them guarantees that.
# Secrets (GEMINI_API_KEY, GROQ_API_KEY, ...) never go here.
NEXT_PUBLIC_SUPABASE_URL=https://dppbsfngrlavgcbmqmgu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tw7iXZQ1e8C75OXqYbzm9w_ObYpuAgj

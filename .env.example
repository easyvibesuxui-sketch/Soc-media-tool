# Copy to .env.local and fill in. NEVER commit .env.local.

# ─── AI providers ─────────────────────────────────────────────────────
# Gemini is the primary (text + attempted image gen). Free: aistudio.google.com
# NOTE: image generation on Gemini requires billing; without it the app falls
# back to Pollinations automatically (no key needed for that).
GEMINI_API_KEY=

# Failover providers for text. callAI() uses these if Gemini fails.
GROQ_API_KEY=          # free: console.groq.com
HF_TOKEN=              # free: huggingface.co/settings/tokens

# ─── Auth (Supabase) ──────────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without these, every AI route returns 503 — the
# guard fails closed on purpose so missing config can't expose the API keys.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The two above are already committed in .env.production for the live project.
SUPABASE_SERVICE_ROLE_KEY=      # only for the LemonSqueezy webhook. Server-only.

# ─── SEO ──────────────────────────────────────────────────────────────
# Used by sitemap.xml, robots.txt and canonical tags. Set to the real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Payments (optional, not wired up yet) ────────────────────────────
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRODUCT_ID=
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=
